{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "unicorn", "vue", "vitest"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist", "graphic_design"],
  "rules": {
    "no-shadow": "off"
  }
}
