{
  "name": "rapidcheapskate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "oxlint --vue-plugin --vitest-plugin --deny-warnings .",
    "lint:fix": "oxlint --vue-plugin --vitest-plugin --fix .",
    "format": "oxfmt src vite.config.ts vitest.config.ts package.json \"tsconfig*.json\" \".ox*.json\" README.md .github .vscode",
    "format:check": "oxfmt --check src vite.config.ts vitest.config.ts package.json \"tsconfig*.json\" \".ox*.json\" README.md .github .vscode"
  },
  "dependencies": {
    "bulma": "^0.9.4",
    "floating-vue": "^5.2.2",
    "vue": "^3.5.42",
    "vue-flatpickr-component": "^12.0.0",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "sass": "^1.103.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
